NODE_ENV=development
APP_BASE_URL=http://localhost:3000
ATLAS_DOMAIN=localhost
ATLAS_CONTAINER_PREFIX=atlas

# Caddy access gate (production). The dashboard's server-side proxy injects the real API
# bearer token, so reaching the dashboard is equivalent to holding operator credentials.
# Both values are REQUIRED by docker-compose.prod.yml. Generate the hash once with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Note the `$` characters in the hash: keep it single-quoted in .env.
ATLAS_BASIC_AUTH_USER=
ATLAS_BASIC_AUTH_HASH=

API_AUTH_TOKEN=
CORS_ALLOWED_ORIGINS=http://localhost:3000
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_MAX_REQUESTS=120

# Production compose secrets (set these to unique values before deployment)
POSTGRES_PASSWORD=
REDIS_PASSWORD=
ENCRYPTION_KEY=

DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas
REDIS_URL=redis://localhost:6379
# Native development uses these host-service health ports; Telegram starts only when its token is set.
WORKER_HEALTH_PORT=8081
TELEGRAM_HEALTH_PORT=8082

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_WEBHOOK_SECRET=

# OpenRouter is the default model route. Enter the key in Dashboard > Settings
# or set MODEL_API_KEY here for headless/native deployments.
MODEL_PROVIDER=openrouter
MODEL_API_KEY=
MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=minimax/minimax-m3:free


# Optional read-only research provider (leave as none to fail closed)
RESEARCH_PROVIDER=none
RESEARCH_API_KEY=
RESEARCH_COUNTRY=ID
RESEARCH_SEARCH_LANG=id

ARTIFACT_STORAGE_PATH=./data/artifacts
MEMORY_MAINTENANCE_INTERVAL_SECONDS=3600
QUEUE_RECOVERY_INTERVAL_SECONDS=30
SCHEDULED_JOB_SYNC_INTERVAL_SECONDS=30
SCHEDULED_JOB_TICK_INTERVAL_SECONDS=60
WORKFLOW_RESUME_INTERVAL_SECONDS=30
AUTOMATION_ENABLED=true
WORKFLOW_AUTOMATION_ENABLED=true
MEMORY_DELETION_GRACE_DAYS=7

GLOBAL_DAILY_BUDGET_USD=5
MAX_CONCURRENT_AGENT_RUNS=3
MAX_DELEGATION_DEPTH=2
EXTERNAL_WRITES_ENABLED=false
PORT=4000
