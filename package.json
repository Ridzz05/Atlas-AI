{
  "name": "atlas-ai-os",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-agent personal AI operating system with Telegram remote control, shared memory, task delegation, and human approval.",
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/dev.mjs",
    "dev:check": "node scripts/dev.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node scripts/lint.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && node --test scripts/native-dev.test.mjs",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "prettier": "3.9.6",
    "rimraf": "^6.0.1",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
