{
    admin off
}

# Set ATLAS_DOMAIN to the public hostname in production; localhost is suitable only for staging.
{$ATLAS_DOMAIN} {
    handle /api/* {
        reverse_proxy agent-service:4000
    }

    handle /health {
        reverse_proxy agent-service:4000
    }

    handle /ready {
        reverse_proxy agent-service:4000
    }

    handle {
        reverse_proxy dashboard:3000
    }
}
